{
  "description": "Language-neutral vectors. Each implementation (TypeScript and Python) must turn `input` into `expected` and report `dropped`.",
  "vectors": [
    {
      "name": "canonical attributes pass through unchanged",
      "input": { "gen_ai.operation.name": "chat", "gen_ai.provider.name": "aws.bedrock", "gen_ai.request.model": "m", "agenticai.tenant.id": "t" },
      "expected": { "gen_ai.operation.name": "chat", "gen_ai.provider.name": "aws.bedrock", "gen_ai.request.model": "m", "agenticai.tenant.id": "t" },
      "dropped": []
    },
    {
      "name": "gen_ai.system becomes gen_ai.provider.name",
      "input": { "gen_ai.system": "aws.bedrock" },
      "expected": { "gen_ai.provider.name": "aws.bedrock" },
      "dropped": []
    },
    {
      "name": "legacy token counters are renamed",
      "input": { "gen_ai.usage.prompt_tokens": 12, "gen_ai.usage.completion_tokens": 34 },
      "expected": { "gen_ai.usage.input_tokens": 12, "gen_ai.usage.output_tokens": 34 },
      "dropped": []
    },
    {
      "name": "the canonical key wins when both forms are present",
      "input": { "gen_ai.system": "openai", "gen_ai.provider.name": "aws.bedrock", "gen_ai.usage.prompt_tokens": 1, "gen_ai.usage.input_tokens": 9 },
      "expected": { "gen_ai.provider.name": "aws.bedrock", "gen_ai.usage.input_tokens": 9 },
      "dropped": []
    },
    {
      "name": "tool_call operation becomes execute_tool",
      "input": { "gen_ai.operation.name": "tool_call", "gen_ai.tool.name": "target___tool-echo" },
      "expected": { "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "target___tool-echo" },
      "dropped": []
    },
    {
      "name": "legacy xai provider value is renamed",
      "input": { "gen_ai.system": "xai" },
      "expected": { "gen_ai.provider.name": "x_ai" },
      "dropped": []
    },
    {
      "name": "a single finish reason string becomes a list",
      "input": { "gen_ai.response.finish_reasons": "stop" },
      "expected": { "gen_ai.response.finish_reasons": ["stop"] },
      "dropped": []
    },
    {
      "name": "removed content attributes are dropped and reported",
      "input": { "gen_ai.prompt": "secret text", "gen_ai.completion": "more text", "gen_ai.request.model": "m" },
      "expected": { "gen_ai.request.model": "m" },
      "dropped": ["gen_ai.completion", "gen_ai.prompt"]
    },
    {
      "name": "the legacy agent extension becomes gen_ai.agent.id",
      "input": { "agenticai.agent.id": "primary", "agenticai.tenant.id": "demo" },
      "expected": { "gen_ai.agent.id": "primary", "agenticai.tenant.id": "demo" },
      "dropped": []
    },
    {
      "name": "unknown attributes are kept as they are",
      "input": { "http.response.status_code": 200, "custom.key": "v" },
      "expected": { "http.response.status_code": 200, "custom.key": "v" },
      "dropped": []
    }
  ]
}
